# AWS ResourceLens — non-secret configuration only.
# Copy to frontend/.env.local for local development.
# Never put IAM access keys, secret keys, or session tokens in this file.

# --- Shared ---
AWS_REGION=us-east-1

# --- Frontend (Vite) ---
VITE_AWS_REGION=us-east-1
VITE_COGNITO_USER_POOL_ID=us-east-1_XXXXXXXXX
VITE_COGNITO_CLIENT_ID=xxxxxxxxxxxxxxxxxxxxxxxxxx
VITE_API_URL=https://xxxxxxxx.execute-api.us-east-1.amazonaws.com
VITE_USE_MOCK=false

# --- Backend Lambda (set by CDK; listed here for reference) ---
# OPERATIONS_TABLE=
# REPORTS_BUCKET=
# PRICE_CACHE_TABLE=
# BEDROCK_MODEL_ID=amazon.nova-lite-v1:0
# CROSS_ACCOUNT_ROLE_ARN=
# ALLOWED_INSTANCE_TYPES=t3.micro,t3.small,t3.medium
# APP_REGION=us-east-1
