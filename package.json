{
  "name": "aws-resourcelens",
  "version": "1.0.0",
  "private": true,
  "description": "AWS ResourceLens — Analyze, Estimate & Manage AWS Resources",
  "workspaces": [
    "frontend",
    "backend",
    "infra"
  ],
  "scripts": {
    "build": "npm run build -w frontend && npm run build -w backend",
    "build:frontend": "npm run build -w frontend",
    "build:backend": "npm run build -w backend",
    "test": "npm run test -w backend",
    "test:frontend": "npm run test -w frontend",
    "dev": "npm run dev -w frontend",
    "lint": "npm run lint -w frontend && npm run lint -w backend",
    "cdk": "npm run cdk -w infra",
    "deploy": "node scripts/deploy.mjs",
    "destroy": "npm run destroy -w infra -- --force --require-approval never"
  },
  "engines": {
    "node": ">=20"
  }
}
